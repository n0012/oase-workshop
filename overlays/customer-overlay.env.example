# ==============================================================================
# Customer-Specific Workshop Overlay Template
# Copy to overlays/<customer>.local.env (gitignored) and run:
#   ./scripts/render-customer-overlay.sh overlays/<customer>.local.env
# ==============================================================================

# 1. Customer & Project Branding
WORKSHOP_CUSTOMER_SLUG="example-customer"
WORKSHOP_ORG_NAME="Example Biopharma R&D"
WORKSHOP_PROJECT_NAME="Example Biopharma — Oral PCSK9 ASCVD"
WORKSHOP_PROJECT_SLUG="example-pcsk9-ascvd"
WORKSHOP_PROGRAM_SLUG="pcsk9-oral"

# 2. Compound Series Prefix (replaces OASE-PCSK9-014 -> <PREFIX>-PCSK9-014)
WORKSHOP_COMPOUND_UPPER="EXBIO"
WORKSHOP_COMPOUND_LOWER="exbio"

# 3. Participating R&D Team Member Emails (assigned role: "project-member")
WORKSHOP_MEMBER_1="compbio-lead@example-biopharma.com"
WORKSHOP_MEMBER_2="medchem-lead@example-biopharma.com"
WORKSHOP_MEMBER_3="dmpk-lead@example-biopharma.com"

# 4. GCP & Scion Hub Environment
WORKSHOP_SCION_HUB_URL="https://scion-hub.example.com"
WORKSHOP_GCP_PROJECT_ID="your-gcp-project-id"
WORKSHOP_GCP_REGION="us-central1"
WORKSHOP_SERVICE_ACCOUNT_EMAIL="scion-default-agent@your-gcp-project-id.iam.gserviceaccount.com"
