# ==============================================================================
# GCP-OASE Hands-On Workshop Environment Configuration (.env.example)
# Copy to .env and populate with your GCP project and Scion Hub endpoints.
# Authentication: Uses GCE VM Metadata / Application Default Credentials (ADC).
# ==============================================================================

# 1. Core Google Cloud Project, Team Pilot Domain & Scion Hub Settings
export GCP_PROJECT_ID="<YOUR_GCP_PROJECT_ID>"
export PROJECT_ID="${GCP_PROJECT_ID}"
export WORKSHOP_DOMAIN="<YOUR_CLOUD_IDENTITY_DOMAIN>"
export REGION="us-central1"
export ZONE="us-central1-c"
export GCS_BUNDLE_BUCKET="${GCP_PROJECT_ID}-bundles"
export SCION_VM_NAME="scion-hub-oase"
export SCION_IAP_SERVICE="scion-hub-oase-iap-proxy"
export STORY_ARC_SERVICE="oase-story-arc"
export HUB_NAME="oase-workshop-hub"
export SCION_HUB_URL="https://oase-workshop-hub.example.com"
export SCION_GCP_PROJECT_ID="${GCP_PROJECT_ID}"
export SCION_SERVICE_ACCOUNT_EMAIL="oase-agent-sa@${GCP_PROJECT_ID}.iam.gserviceaccount.com"

# 2. Shared OASE Tools Volume & Workspace Paths
export OASE_TOOLS_HOME="/scion-volumes/tools"
export OASE_PACE_DIR="/home/scion/.cache/oase/pace"
export OASE_PROJECT="/workspace/live-sandbox"

# 3. Dedicated GCP AlphaFold 3 GPU Endpoint (oase alphafold predict)
#    Uses google.auth.default() ADC and single-flight lock at OASE_AF3_LOCK.
export OASE_AF3_PROJECT="${PROJECT_ID}"
export OASE_AF3_REGION="us-central1"
export OASE_AF3_ENDPOINT_NAME="alphafold3-dedicated-endpoint"
export OASE_AF3_LOCK="/home/scion/.cache/oase/af3.lock"

# 4. Dedicated GCP AlphaGenome GPU Endpoint (oase alphagenome score-variant / predict-interval)
#    Defaults to --backend vertex via GCE ADC against the Dedicated Endpoint DNS.
export OASE_AG_PROJECT="${PROJECT_ID}"
export OASE_AG_REGION="us-central1"
export OASE_AG_ENDPOINT_ID="<YOUR_ALPHAGENOME_ENDPOINT_ID>"
export OASE_AG_ENDPOINT_DNS="<YOUR_ALPHAGENOME_ENDPOINT_ID>.us-central1-<YOUR_PROJECT_NUMBER>.prediction.vertexai.goog"

# 5. BigQuery Literature Triage Corpus (oase pubmed-bq search / analyze)
export OASE_PUBMED_BQ_DATASET="${PROJECT_ID}.pubmed_corpus"

# 6. Multi-Model Agent Harness Configuration (Scion Portable Size Aliases)
#    Templates specify small | medium | large | extra-large; Scion resolves these at spawn time.
export SCION_DEFAULT_HARNESS="gemini-cli"
export SCION_DEFAULT_MODEL="large"
export SCION_HARNESS_ORCHESTRATOR="gcp/gemini-4-pro"
export SCION_HARNESS_REVIEWER="gcp/claude-sonnet-4-6"
export SCION_HARNESS_HYPEX_PANEL="gcp/gemini-4-pro,gcp/claude-sonnet-4-6,openai/gpt-4.1"
