# ==============================================================================
# GCP-OASE (Open Agentic Science Engine) — Hands-On Workshop Environment Config
# Copy to .env and source before running scripts/preflight.sh or scripts/seed-hub.sh
# ==============================================================================

# --- 1. Core Google Cloud Project & Scion Hub ---
export PROJECT_ID="your-gcp-project-id"
export PROJECT_NUMBER="123456789012"
export REGION="us-central1"
export ZONE="us-central1-a"
export HUB_NAME="oase-workshop-hub"
export VM_NAME="oase-workshop-vm"

# --- 2. OASE Runtime & Shared Volume Paths ---
export OASE_TOOLS_HOME="/scion-volumes/tools"
export OASE_VENV="/scion-volumes/tools/.venv"
# Set per active grove or pass --project <dir> on the CLI:
export OASE_PROJECT="/workspace/live-sandbox"
export OASE_PACE_DIR="/scion-volumes/tools/.pace"

# --- 3. Vertex AI AlphaFold 3 Dedicated Endpoint (ADC Auth) ---
# Used by: oase alphafold predict --input <json>
# Auth: Resolved automatically via GCE Workload Identity / google.auth.default()
export OASE_AF3_PROJECT="${PROJECT_ID}"
export OASE_AF3_REGION="us-central1"
export OASE_AF3_ENDPOINT_NAME="AlphaFold 3 Dedicated Endpoint"
export OASE_AF3_LOCK="${HOME}/.cache/oase/af3.lock"

# --- 4. Vertex AI AlphaGenome Dedicated Endpoint (ADC Auth) ---
# Used by: oase alphagenome score-variant / predict-interval (--backend vertex)
# Note: Dedicated endpoints require their dedicated *.prediction.vertexai.goog DNS host
export OASE_AG_PROJECT="${PROJECT_ID}"
export OASE_AG_REGION="us-central1"
export OASE_AG_ENDPOINT_ID="mg-endpoint-your-alphagenome-id"
export OASE_AG_ENDPOINT_DNS="${OASE_AG_ENDPOINT_ID}.${OASE_AG_REGION}-${PROJECT_NUMBER}.prediction.vertexai.goog"

# Optional: Only required if running `oase alphagenome ism` (--backend pip)
# Leave unset for standard workshop exercises (which use --backend vertex via ADC)
# export ALPHAGENOME_API_KEY=""

# --- 5. BigQuery High-Throughput Literature Triage ---
# Used by: oase pubmed-bq search "<QUERY>" / oase pubmed-bq analyze "<QUERY>"
export OASE_PUBMED_BQ_DATASET="${PROJECT_ID}.pubmed.articles"

# --- 6. Scion Multi-Model Harnesses (Vertex AI Gemini 4 + Claude + OpenAI) ---
# Scion decouples Agent Templates (.scion/templates/) from Model Harnesses.
# Gemini 4 & Claude Partner Models authenticate via Vertex AI ADC in PROJECT_ID.
export VERTEX_MODEL_PRIMARY="gemini-4-pro"
export VERTEX_MODEL_FAST="gemini-4-flash"
export VERTEX_MODEL_REVIEWER="claude-sonnet-4-6"
# Optional: For multi-cloud Hypex tournament diversity if OpenAI harness is enabled
# export OPENAI_API_KEY=""
